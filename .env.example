# Copy to .env; setup.sh creates local-only credentials if absent.
DATABASE_URL=postgresql://inforteks:CHANGE_ME@127.0.0.1:5432/inforteks
# Optional direct connection for migrations when DATABASE_URL uses a pooler.
# DIRECT_DATABASE_URL=postgresql://...
DATABASE_POOL_MAX=10
DATABASE_CONNECT_TIMEOUT_MS=5000
DATABASE_IDLE_TIMEOUT_MS=30000
DATABASE_STATEMENT_TIMEOUT_MS=30000
DATABASE_APPLICATION_NAME=inforteks
BETTER_AUTH_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS
BETTER_AUTH_URL=http://localhost:3000
APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Optional Google OAuth web client from the Google Cloud project linked to Firebase.
# Web-service secrets only; both are required before the Google button appears.
# Authorized redirect: <BETTER_AUTH_URL>/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
STORAGE_DRIVER=local
UPLOAD_DIR=.data/uploads
# Alternative production storage: STORAGE_DRIVER=blob with a private Vercel store.
BLOB_READ_WRITE_TOKEN=
# Production S3-compatible storage (private bucket, stable /media URLs)
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=true
# Optional providers: absent means disconnected, never simulated as live.
AI_PROVIDER=
# Optional public comparison explanation: requires web-side OpenAI credentials.
# Five requests/customer/day and 100 requests/store/day; disabled by default.
AI_COMPARE_ENABLED=false
OPENAI_API_KEY=
OPENAI_MODEL=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
AI_MAX_STEPS=6
AI_MAX_OUTPUT_TOKENS=1500
EMAIL_PROVIDER=development
EMAIL_FROM=
RESEND_API_KEY=
# Enable only after real sender/domain verification and email delivery checks.
AUTH_REQUIRE_EMAIL_VERIFICATION=false
OFFLINE_PAYMENTS_ENABLED=false
DEV_PAYMENT_SIMULATOR=false
WORKER_POLL_MS=3000
WORKER_MAX_ATTEMPTS=3
WORKER_HEALTH_PORT=8081
